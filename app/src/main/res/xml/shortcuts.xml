<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="record"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_record"
        android:shortcutShortLabel="@string/shortcut_record_short"
        android:shortcutLongLabel="@string/shortcut_record_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="net.ark3us.saferec.QuickStartActivity"
            android:targetPackage="net.ark3us.saferec">
            <extra
                android:name="net.ark3us.saferec.extra.SOURCE"
                android:value="shortcut" />
        </intent>
    </shortcut>
</shortcuts>
